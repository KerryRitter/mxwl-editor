---
import Icon from './Icon.astro';
---

<section class="closing section container">
  <div class="eyebrow">
    <span class="tiny-cross" aria-hidden="true">
      +
    </span>{' '}
    A BETTER PLACE TO BUILD
  </div>
  <h2>
    Your next workspace
    <br />
    starts here<span class="accent">.</span>
  </h2>
  <p>Open a folder. Bring your tools. Make something good.</p>
  <div class="button-row">
    <a href="/download/" class="button primary">
      <Icon name="download" size={18} />
      Get mxwl
    </a>
    <a href="/docs/getting-started/" class="button secondary">
      Read the quick start
    </a>
  </div>
  <div class="closing-note mono">OPEN SOURCE · MIT LICENSE · EARLY ALPHA</div>
</section>
