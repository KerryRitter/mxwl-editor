---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="That workspace doesn't exist. Find your way back to mxwl."
>
  <section class="container not-found">
    <div class="pixel-wordmark" aria-hidden="true">
      404
    </div>
    <h1>A little out of context.</h1>
    <p>We couldn’t find that page. Let’s get you back to the workspace.</p>
    <div class="button-row">
      <a class="button primary" href="/">
        Back to mxwl
      </a>
      <a class="button secondary" href="/docs/">
        Open the manual
      </a>
    </div>
  </section>
</Base>
