---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { guides, product } from '../../data/product';
const groups = [...new Set(guides.map((guide) => guide.group))];
---

<Base
  title="The manual"
  description="Everything you need to get started with mxwl: workspaces, agents, remote hosts, browser sandboxes, plugins, and the full SDK reference."
>
  <div class="manual-header">
    <header class="page-hero container">
      <div class="eyebrow">READ. BUILD. MAKE IT YOURS.</div>
      <h1>
        The manual<span class="accent">.</span>
      </h1>
      <p class="lead">
        The ideas behind the editor, the details that make it work, and a few good places to start.
      </p>
    </header>
  </div>
  <div class="container manual-grid">
    <aside class="manual-sidebar" aria-label="Guide groups">
      {groups.map((group) => (
        <a href={`#${group.toLowerCase().replaceAll(' ', '-')}`}>{group}</a>
      ))}
      <div class="manual-note">
        <p>
          New here?
          <br />
          <a class="text-link" href="/docs/getting-started/">
            Start with a folder
          </a>
        </p>
      </div>
    </aside>
    <div class="doc-main">
      {groups.map((group) => (
        <section class="guide-group" id={group.toLowerCase().replaceAll(' ', '-')}>
          <h2>{group.toUpperCase()}</h2>
          {guides
            .filter((guide) => guide.group === group)
            .map((guide) => (
              <a class="guide-card" href={`/docs/${guide.slug}/`}>
                <span class="number">{guide.number}</span>
                <div>
                  <h3>{guide.title}</h3>
                  <p>{guide.description}</p>
                </div>
                <Icon name="book" size={19} />
              </a>
            ))}
        </section>
      ))}
      <div class="manual-note">
        <h2>Built in the open.</h2>
        <p>
          The reference guides come directly from the editor’s documentation. Found something we
          could explain better?{' '}
          <a href={`${product.repository}/issues`} class="text-link">
            Tell us on GitHub
          </a>
        </p>
      </div>
    </div>
  </div>
</Base>
