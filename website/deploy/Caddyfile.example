# Replace the path with this checkout's absolute dist directory.
# DNS must already point at the server receiving these requests.
mxwl.work {
	redir https://www.mxwl.work{uri} permanent
}

www.mxwl.work {
	root * /srv/www.mxwl.work/dist
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
